set -e

CLUSTER_ID="eCFJfuyGTTG-G5wu7YCz4A"   # replace with YOUR actual UUID generated in Step 5

echo "Formatting broker1..."
/opt/kafka/bin/kafka-storage.sh format \
  -t $CLUSTER_ID \
